  r0=field(b,'改期原因','select');[['customer','客人改期（取機 3 日前）'],['event','活動遭取消或延期']].forEach(function(x){var e=el('option','',x[1]);e.value=x[0];r0.appendChild(e)});
  var r=el('div','row');b.appendChild(r);var c1=el('div'),c2=el('div');r.appendChild(c1);r.appendChild(c2);
  ds=field(c1,'新取機日','input',{type:'date',value:dateOf(o.start)});ts=slotSelect(c2,'新取機時間',timeOf(o.start));
  var r2=el('div','row');b.appendChild(r2);var c3=el('div'),c4=el('div');r2.appendChild(c3);r2.appendChild(c4);
  de=field(c3,'新歸還日','input',{type:'date',value:dateOf(o.end)});te=slotSelect(c4,'新歸還時間',timeOf(o.end));
