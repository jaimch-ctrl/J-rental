function dlgCancel(o){var r,pv;
  function up(){pv.textContent='';kv(pv,'應退預約金',money(cancelRefund(o.prepay,dateOf(o.start),today(),r.value,o.status!=='待匯款')))}
  modal('取消訂單',function(b){
    r=field(b,'取消原因','select');[['customer','客人取消'],['noshow','未到場'],['owner','甲方因素（加倍返還）']].forEach(function(x){var e=el('option','',x[1]);e.value=x[0];r.appendChild(e)});
    pv=el('div','preview');b.appendChild(pv);r.onchange=up;up();
  },function(){return{action:'admin_cancel',id:o.id,reason:r.value}},'確認取消');
}
function dlgNote(o){var n;modal('備註',function(b){n=field(b,'備註內容','textarea',{rows:4,maxLength:500,value:o.note||''})},function(){return{action:'admin_note',id:o.id,note:n.value}},'儲存')}

/* ---- 合約 ---- */
function fillBlanks(line,vals){var i=0;return line.replace(/＿+/g,function(m){var v=vals[i++];return v===undefined||v===''?m:v})}
function num(n){return Number(n||0).toLocaleString('en-US')}
function dt(s){return[s.slice(0,4),s.slice(5,7),s.slice(8,10),s.slice(11,13),s.slice(14,16)]}
function contractLines(o){
  var phone=0,addr=0,ref=o.plan==='referral',lens=RULES.equipment[o.equip].lens;
  return CONTRACT.map(function(c){
    var t=c.t;
    function has(p){return t.indexOf(p)===0}
    if(has('合約編號'))t=fillBlanks(t,[o.id]);
    else if(has('聯絡電話'))t=fillBlanks(t,[phone++===0?A.shop.phone:o.phone]);
    else if(has('聯絡地址')){if(addr++===0)t=fillBlanks(t,[A.shop.address])}
    else if(has('姓名：'))t=fillBlanks(t,[o.name]);
    else if(has('手機序號'))t=fillBlanks(t,[o.unit]);
    else if(has('增距鏡型號'))t=fillBlanks(t,[lens?lens+'mm':'無']);
    else if(has('一、租借起始時間'))t=fillBlanks(t,dt(o.start));
    else if(has('二、預定歸還時間'))t=fillBlanks(t,dt(o.end));
    else if(has('租賃方案'))t=fillBlanks(t,[o.planLabel+'，'+o.equipLabel]);
    else if(has('租賃天數'))t=fillBlanks(t,[String(o.days)]);
    else if(has('約定租金'))t=fillBlanks(t,[num(o.rent)]);
    else if(has('押金：新臺幣'))t=fillBlanks(t,[num(o.deposit)]);
    else if(has('預約金（'))t=fillBlanks(t,[num(o.prepay)]);
    else if(has('應付總額'))t=fillBlanks(t,[num(o.rent+o.deposit)]);
    else if(has('取機時應付'))t=fillBlanks(t,[num(o.dueAtPickup)]);
    else if(has('□ 國內租借')&&!ref&&o.region==='國內')t=t.replace('□','☑');
    else if(has('□ 國外租借')&&!ref&&o.region==='國外')t=t.replace('□','☑');
    else if(has('□ 介紹人專案')&&ref)t=t.replace('□','☑');
    return{k:c.k,t:t};
  });
}
function showContract(o){
  var p=$('print');p.textContent='';p.className='show';
  var bar=el('div','printbar noprint'),b1=el('button','btn','列印／存成 PDF'),b2=el('button','btn','關閉');b1.type=b2.type='button';
  b1.onclick=function(){window.print()};b2.onclick=function(){p.className='';p.textContent=''};bar.appendChild(b1);bar.appendChild(b2);p.appendChild(bar);
  var d=el('div','doc'),box=null;
  contractLines(o).forEach(function(c){
    if(c.k==='box'){if(!box){box=el('div','box');d.appendChild(box)}box.appendChild(el('p','',c.t));return}
    box=null;
    d.appendChild(el(c.k==='h1'?'h3':c.k==='h2'?'h4':'p',c.k==='s'?'s':'',c.t));
  });
  p.appendChild(d);p.scrollTop=0;
}
