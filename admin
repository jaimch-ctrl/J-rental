function modal(title,build,onOk,okText){
  var s=$('sheet');s.textContent='';s.appendChild(el('h2','',title));
  var body=el('div');s.appendChild(body);build(body);
  var e=el('p','err');e.setAttribute('role','alert');s.appendChild(e);
  var bar=el('div','bar'),no=el('button','btn','取消返回'),ok=el('button','btn main',okText||'確定');no.type=ok.type='button';
  no.onclick=close;
  ok.onclick=function(){
    var q;try{q=onOk()}catch(x){e.textContent=x.message;return}
    ok.disabled=true;e.textContent='';
    api(q).then(function(r){ok.disabled=false;if(!r.ok){e.textContent=r.err;return}close();load()}).catch(function(){ok.disabled=false;e.textContent='連線失敗，請再試一次'});
  };
  bar.appendChild(no);bar.appendChild(ok);s.appendChild(bar);$('modal').hidden=false;
}
function close(){$('modal').hidden=true}
